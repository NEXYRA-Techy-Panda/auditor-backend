{
  "name": "auditor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NEXYRA auditor backend (F2 scaffold: health route only).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "verify:contract": "node scripts/verify-contract.mjs",
    "validate:schema": "node scripts/validate-schema.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cors": "2.8.6",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
