# auditor-backend — copy to .env for local overrides (never commit .env).
# All values are optional; fixed runtime defaults are shown.

# The HTTP port is fixed at 19002 in source; PORT is intentionally ignored.
# 127.0.0.1 keeps the service private behind the VPS reverse proxy.
HOST=127.0.0.1

# Single allowed browser origin for CORS (the auditor-frontend dev server).
# CORS is not authentication.
FRONTEND_ORIGIN=http://localhost:3001

# Private energy-ml-service ORIGIN only (no path); callers append contract
# routes such as /health and /v1/... . Used server-side only.
ML_SERVICE_URL=http://127.0.0.1:19003
ML_TIMEOUT_MS=10000

# Maximum JSON request body (Express/body-parser size string).
JSON_BODY_LIMIT=100kb

# Graceful-shutdown deadline before open connections are force-closed (ms).
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_PATH=./data/auditor.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000
# Maximum uploaded file size (512 MiB; range 1 byte–1 GiB).
UPLOAD_MAX_BYTES=536870912
